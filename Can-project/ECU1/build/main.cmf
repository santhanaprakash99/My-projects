%CMF
# %PSECTS Section
# For each object file, details of its psects are enumerated here.
# The begining of the section is indicated by %PSECTS.  The first
# line indicates the name of the first object file, e.g.
#    $foo.obj
# Each line that follows describes a psect in that object file, until
# the next object file.  The lines that describe a psect have the
# format:
#    <psect name> <class name> <space> <link address> <load addresses> <length> <delta> <reloc>
# All addresses and the length are given in unqualified hexadecimal
# in delta units.  Any other numeric values are decimal.
%PSECTS
$build/main.o
cinit CODE 0 28B0 28B0 2E 1 2
idloc IDLOC 5 200000 200000 8 1 1
text0 CODE 0 2890 2890 20 1 2
text1 CODE 0 2862 2862 12 1 2
text2 CODE 0 2C1A 2C1A 9E 1 2
text3 CODE 0 28DE 28DE 3A 1 2
text4 CODE 0 2954 2954 3C 1 2
text5 CODE 0 2874 2874 1C 1 2
text6 CODE 0 2D5C 2D5C BC 1 2
text7 CODE 0 2990 2990 46 1 2
text8 CODE 0 29D6 29D6 64 1 2
text9 CODE 0 2AA4 2AA4 72 1 2
text10 CODE 0 2A3A 2A3A 6A 1 2
text11 CODE 0 2CB8 2CB8 A4 1 2
text12 CODE 0 2E18 2E18 BE 1 2
text13 CODE 0 2B16 2B16 74 1 2
text14 CODE 0 2ED6 2ED6 108 1 2
text15 CODE 0 2B8A 2B8A 90 1 2
text16 CODE 0 2918 2918 3C 1 2
idataCOMRAM CODE 0 2860 2860 2 1 1
cstackCOMRAM COMRAM 1 1 1 1F 1 1
dataCOMRAM COMRAM 1 32 32 2 1 1
bssCOMRAM COMRAM 1 20 20 12 1 1
mediumconst MEDIUMCONST 0 2FDE 2FDE 1E 1 2
config CONFIG 4 300000 300000 E 1 1
$build/startup.o
idloc IDLOC 5 200000 200000 8 1 1
init CODE 0 2FFC 2FFC 4 1 2
reset_vec CODE 0 0 0 4 1 2
config CONFIG 4 300000 300000 E 1 1
# %UNUSED Section
# This section enumerates the unused ranges of each CLASS. Each entry
# is described on a single line as follows:
#    <class name> <range> <delta>
# Addresses given in the range are in hexadecimal and units of delta.
%UNUSED
RAM 60-5FF 1
SFR D00-FFF 1
BANK0 60-FF 1
BANK1 100-1FF 1
BANK2 200-2FF 1
BANK3 300-3FF 1
BANK4 400-4FF 1
BANK5 500-5FF 1
CONST 4-285F 1
CONST 3000-3000 1
SMALLCONST 600-285F 1
SMALLCONST 3000-3000 1
CODE 4-285F 1
CODE 3000-3000 1
BIGRAM 34-5FF 1
BIGSFR D00-FFF 1
COMRAM 34-5F 1
EEDATA F00000-F000FF 1
MEDIUMCONST 600-285F 1
MEDIUMCONST 3000-3000 1
# %LINETAB Section
# This section enumerates the file/line to address mappings.
# The beginning of the section is indicated by %LINETAB.
# The first line indicates the name of the first object file, e.g.
#   $foo.obj
# Each line that follows describes a single mapping until the next
# object file.  Mappings have the following format:
#    <address> <psect name> <class name> ><line number>:<file name>
# The address is absolute and given given in unqualified hex 
# in delta units of the psect. All mappings within an object file
# are in ascending order of addresses.
# All other numeric values are in decimal.
%LINETAB
$build/main.o
